# DNS deste domínio deve apontar para o endereço do servidor.
SHR_DOMAIN=supervisao.example.com
# Gere uma frase-senha aleatória com pelo menos 20 caracteres e compartilhe-a com a equipe.
SHR_SHARED_PASSWORD=troque-por-uma-frase-senha-aleatoria-de-pelo-menos-20-caracteres
# IDs atuais verificados nas documentações oficiais; acesso depende da sua conta.
# Nenhuma chave de API fica aqui.
SHR_MODELS_JSON='{"openai":["gpt-6.1-sol","gpt-6-luna","gpt-6-astra"],"anthropic":["claude-sonnet-5-5","claude-haiku-5-5","claude-opus-5-5","claude-fable-5-1"],"gemini":["gemini-3.8-flash"]}'
